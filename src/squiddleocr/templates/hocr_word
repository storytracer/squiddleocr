{# SquiddleOCR: kraken's hocr template without the character-level properties (x_bboxes on the line, x_confs on the word); words carry x_wconf (0-100) instead (word-level detail); keep in step with kraken's templates/hocr #}
{% macro render_line(line) -%}
		{% if line.bbox -%}
		<span class="ocr_line" id="{{ line.id }}" title="bbox {{ line.bbox|join(' ') }}{% if line.boundary -%}; poly {{ line.boundary|sum(start=[])|join(' ') }}{% endif %}">
		{% for segment in line.recognition %}
			<span class="ocrx_word" id="segment_{{ segment.index }}" title="bbox {{ segment.bbox|join(' ') }}; x_wconf {{ (segment.confidences|sum / segment.confidences|length * 100)|round(2) }}{% if segment.boundary -%}; poly {{ segment.boundary|sum(start=[])|join(' ') }}{% endif %}">{{ segment.text }}</span>
		{% endfor -%}
		</span>
		<br/>
		{%- endif %}
{%- endmacro -%}
<!DOCTYPE html>
<html>
	<head>
		<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
		<meta name="ocr-system" content="kraken"/>
		<meta name="ocr-capabilities" content="ocr_page ocrx_block ocr_line ocrx_word ocrp_poly"/>
		{% if page.scripts %}
		<meta name="ocr-scripts" content="{{ page.scripts|join(' ') }}"/>
		{% endif %}
	</head>
	<body>
		<div class="ocr_page" title="bbox 0 0 {{ page.size|join(' ') }}; image {{ page.name }}" style="writing-mode: {{ page.writing_mode }};">
			{% for entity in page.entities -%}
			{% if entity.type == "region" -%}
			{% if entity.bbox -%}
			<div class="ocrx_block" id="{{ entity.id }}" data-region-type="{{ entity.region_type }}" title="bbox {{ entity.bbox|join(' ') }}{% if entity.boundary %}; poly {{ entity.boundary|sum(start=[])|join(' ') }}{% endif %}">
				{% for line in entity.lines -%}
				{{ render_line(line) }}
				{% endfor %}
			</div>
			{% else -%}
				{% for line in entity.lines -%}
				{{ render_line(line) }}
				{% endfor %}
			{% endif -%}
			{% else -%}
			{{ render_line(entity) }}
			{% endif -%}
			{% endfor -%}
		</div>
	</body>
</html>
